# ==============================================================================
# .gitignore — Huwag (Godot 4.7 / GDScript)
# ==============================================================================
# Nota sobre Godot 4:
#   - .godot/ é cache local gerado pela engine (sempre ignorado).
#   - Arquivos *.import e *.uid permanecem versionados para preservar presets
#     pixel-perfect (Nearest), tipografia e referências de cenas entre clones.

# Godot 4: cache local e exportações
.godot/
*.translation
export/
exports/
build/
builds/
*.exe
*.pck
*.apk
*.aab
*.app/
*.dmg
*.zip
*.tar.gz
override.cfg

# Godot C# / Mono (caso habilitado no futuro)
.mono/
data_*/
mono_crash.*.json

# Logs, backups e arquivos temporários
docs/logs/*
!docs/logs/README.md
*.log
*.tmp
*.bak
*.orig
*.swp
*~

# Saves locais de teste
*.sav
*huwag_save.json

# Ferramentas de desenvolvimento local / habilidades de IA (fora do repositório)
.agents/
.antigravity_bridge/
scratch/

# Python / scripts auxiliares locais
__pycache__/
*.py[cod]
.venv/
venv/

# Metadados de Sistema Operacional
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
__MACOSX/

# IDEs e editores
.vscode/
.idea/
*.suo
*.user
*.sln.docstates
